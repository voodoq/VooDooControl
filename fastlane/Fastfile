# Fastfile
# Describes how to build and deploy the app

default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    scan(
      project: "VooDooControl.xcodeproj",
      scheme: "VooDooControl",
      destination: "platform=iOS Simulator,name=iPhone 16 Pro"
    )
  end

  desc "Build debug version"
  lane :build do
    gym(
      project: "VooDooControl.xcodeproj",
      scheme: "VooDooControl",
      configuration: "Debug",
      skip_package_ipa: true,
      skip_archive: true
    )
  end

  desc "Deploy to TestFlight"
  lane :beta do
    increment_build_number(
      xcodeproj: "VooDooControl.xcodeproj"
    )
    
    match(type: "appstore")
    
    gym(
      project: "VooDooControl.xcodeproj",
      scheme: "VooDooControl",
      export_method: "app-store"
    )
    
    pilot(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy to App Store"
  lane :release do
    increment_version_number(
      xcodeproj: "VooDooControl.xcodeproj"
    )
    
    increment_build_number(
      xcodeproj: "VooDooControl.xcodeproj"
    )
    
    match(type: "appstore")
    
    gym(
      project: "VooDooControl.xcodeproj",
      scheme: "VooDooControl",
      export_method: "app-store"
    )
    
    deliver(
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false
    )
  end

  desc "Setup certificates"
  lane :certificates do
    match(type: "development")
    match(type: "appstore")
  end
end
